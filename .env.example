# OpenCode — modelo de chat (cable openai-compatible)
OPENCODE_GO_API_KEY=sk-tu-api-key-aqui
OPENCODE_GO_BASE_URL=https://api.opencode.ai

# Router de chat (DEC-0004)
LLM_PROVIDER=openai
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini — embeddings por defecto (separadas por coma para rotación)
GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Embeddings — backend compartido plugin/MCP (DEC-0023)
# sentence-transformers requiere sidecar Python manual; no es fallback de Gemini.
SANCTUM_EMBED_BACKEND=gemini
SANCTUM_LOCAL_EMBED_PORT=8767
SANCTUM_LOCAL_EMBED_TOKEN=
SANCTUM_LOCAL_EMBED_REVISION=
SANCTUM_LOCAL_EMBED_DIMS=768
SANCTUM_LOCAL_EMBED_DEVICE=cpu
SANCTUM_LOCAL_EMBED_DTYPE=float32

# MCP — proyecto por defecto para tools que lo exigen (sanctum_query_vault, notas)
SANCTUM_PROJECT_ID=

# MCP HTTP local (DEC-0022) — usar npm run mcp:http (launcher Node portable)
SANCTUM_MCP_HTTP=1
SANCTUM_MCP_PORT=8787
SANCTUM_MCP_TOKEN=
SANCTUM_MCP_ORIGINS=http://127.0.0.1:5173

# Tavily — búsqueda web (opcional)
TAVILY_API_KEY=tvly-tu-api-key-aqui

# Discord (proceso aparte: npm run discord). Sin token, guild o canales, sale.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
XAI_API_KEY=
XAI_MODEL=grok-4.7
