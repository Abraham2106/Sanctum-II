# OpenCode — modelo de chat (cable openai-compatible)
OPENCODE_GO_API_KEY=sk-tu-api-key-aqui
OPENCODE_GO_BASE_URL=https://api.opencode.ai

# Router de chat (DEC-0004)
LLM_PROVIDER=openai
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Gemini — embeddings (separadas por coma para rotación)
GEMINI_API_KEYS=AIza...,AIza...,AIza...

# Tavily — búsqueda web (opcional, sin esto el agente no puede buscar en web)
TAVILY_API_KEY=tvly-tu-api-key-aqui

# Discord (proceso aparte: npm run discord). Sin token, guild o canales, sale.
# Grok si hay XAI_API_KEY; si no, OPENCODE_GO_*. Grok Bot no tiene conector Discord.
# El vault se le ofrece con: node mcp-server/dist/index.cjs
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
XAI_API_KEY=
XAI_MODEL=grok-4.7
